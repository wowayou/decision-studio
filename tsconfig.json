{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "noEmit": true,
    "noUnusedLocals": true, "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true, "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true, "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "tests", "playwright.config.ts", "vite.config.ts"]
}
